    "peekViewResult.background": "#F1EEE1",
    "peekViewTitle.background": "#F1EEE1",

    "extensionButton.prominentBackground": "#CC785C",
    "extensionButton.prominentForeground": "#F5F4EE",
    "extensionButton.prominentHoverBackground": "#B8654A"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#282828"
      }
    },
    {
      "name": "Comments and docstrings",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment",
        "comment.block.documentation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#928374"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "string.regexp"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#689d6a"
      }
    },
    {
      "name": "Keywords, control flow, storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "constant.language.boolean",
        "variable.language.self",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#458588"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#458588"
      }
    },
    {
      "name": "Functions and classes",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#282828"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#b16286"
      }
    },
    {
      "name": "Object fields, properties, dunders",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "punctuation.definition.variable",
        "variable.other.constant",
        "constant.other.placeholder",
        "support.type.property-name",
        "variable.parameter.function.language.special.self",
        "entity.name.function.magic",
        "support.function.magic",
        "variable.language.special"
      ],
      "settings": {
        "foreground": "#8f3f71"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#98971a"
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "punctuation",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#282828"
      }
    },
    {
      "name": "Tags (markup/html)",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#458588"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#98971a"
      }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8f3f71"
      }
    },
    {
      "name": "Markup bold/italic",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#9D0006"
      }
    }
  ]
}
