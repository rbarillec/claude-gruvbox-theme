    "notifications.foreground": "#282828",
    "notifications.border": "#D9D4C0",
    "notificationsErrorIcon.foreground": "#9D0006",
    "notificationsWarningIcon.foreground": "#B57614",
    "notificationsInfoIcon.foreground": "#458588",

    "peekView.border": "#CC785C",
